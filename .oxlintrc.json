{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__resetStore",
          "__resetRateLimits"
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "components/ui/**"
  ]
}
